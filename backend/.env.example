PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_DATABASE=devportal
# Chỉ bật trong môi trường phát triển. Production nên dùng migration.
DB_SYNCHRONIZE=true

JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_TIME_ZONE=Asia/Bangkok
CALIBRATION_REMINDERS_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=DEVPORTAL <your_email@gmail.com>
EMPLOYEE_FRONTEND_URL=http://localhost:5174

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
